# Copy this file to .env for local use. Never commit .env.

# Generic OpenAI-compatible gateway used by AgentPanel and frozen benchmarks.
LLM_GATEWAY_API_KEY=
LLM_GATEWAY_API_URL=https://gateway.example/v1/chat/completions
LLM_GATEWAY_API_BASE_URL=https://gateway.example/v1
LLM_GATEWAY_MODEL=

# Optional public providers.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Optional additional OpenAI-compatible provider.
GPTPLUS5_API_KEY=
GPTPLUS5_API_BASE=https://provider.example/v1

# Optional Moltbook API access for the scraper.
MOLTBOOK_API_KEY=
